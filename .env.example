# YouCam API (https://yce.perfectcorp.com/api-console/en/api-keys/). Server-only. Never commit a real key.
YOUCAM_API_KEY=
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
YOUCAM_TIMEOUT_MS=30000

# Stop live analysis for anonymous visitors when the unit balance drops below this.
CREDIT_RESERVE=200
# Live analyses allowed per visitor IP per day.
LIVE_DAILY_CAP_PER_IP=3

# Postgres (Neon) for production. Leave empty locally to use embedded PGlite in .data/.
DATABASE_URL=

# Secret used to hash studio admin tokens and visitor IPs. Use a long random string
# (e.g. `openssl rand -base64 32`) and never change it after launch.
APP_SECRET=
